{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "api/market.py", "use": "@vercel/python" },
    { "src": "api/weather.py", "use": "@vercel/python" },
    { "src": "api/calendar.py", "use": "@vercel/python" },
    { "src": "api/news.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/market/*", "dest": "api/market.py" },
    { "src": "/aph/weather/*", "dest": "api/weather.py" },
    { "src": "/api/calendar/*", "dest": "api/calendar.py" },
    { "src": "/api/news/*", "dest": "api/news.py" },
    { "src": "/**", "dest": "api/index.py" }
  ]
}
