{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "api/market.py", "use": "@vercel/python" },
    { "src": "api/weather.py", "use": "@vercel/python" },
    { "src": "api/calendar.py", "use": "@vercel/python" },
    { "src": "api/news.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/market", "dest": "$1"},
    { "src": "/api/weather", "dest": "$1"},
    { "src": "/api/calendar", "dest": "$1"},
    { "src": "/api/news","dest": "$1"},
    { "src": "/(.*)", "dest": "/api/index"}
  ]
}